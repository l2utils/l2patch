# Lineage 2 Patch Server & Updater Configuration
# In GitHub Actions, these are provided via GitHub Organization Secrets.
# For local use, copy to .env and configure.

# NCSoft Updater Server (TCP socket port 27500)
L2_PATCH_UPDATER_HOST=updater.nclauncher.ncsoft.com
L2_PATCH_UPDATER_PORT=27500
L2_PATCH_GAME_ID=LINEAGE2

# Base CDN URL or Host (can also be queried live using: npx l2patch cdn --env)
# L2_PATCH_BASE_URL=http://d35293xeakkyq4.cloudfront.net/LINEAGE2
# L2_PATCH_CDN_HOST=d35293xeakkyq4.cloudfront.net

# Optional HTTP version endpoint or manifest URL (if not querying TCP updater)
# L2_PATCH_VERSION_URL=

# Optional authentication token or header value if required by the patch CDN
# L2_PATCH_AUTH_TOKEN=
