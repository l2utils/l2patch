# Lineage 2 Patch Server Configuration
# These are sensitive / proprietary endpoints and should be injected via GitHub Organization Secrets
# or local .env file. Never commit live URLs to source control.

# Base CDN URL where patch zips and delta patches are served
L2_PATCH_BASE_URL=https://example-cdn.lineage2.com/patch

# Endpoint or manifest URL for checking the current/latest client version
L2_PATCH_VERSION_URL=https://example-cdn.lineage2.com/patch/version.json

# Optional authentication token or header value if required by the patch CDN
# L2_PATCH_AUTH_TOKEN=
