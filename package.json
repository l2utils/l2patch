  "bugs": {
    "url": "https://github.com/l2utils/l2patch/issues"
  },
  "homepage": "https://github.com/l2utils/l2patch#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.5",
    "jest": "^30.2.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "commander": "^14.0.2"
  }
