{
  "name": "@l2utils/l2patch",
  "version": "1.0.0",
  "description": "Lineage 2 client patch inspection and file download utility",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
